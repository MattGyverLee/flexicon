#!/bin/sh
#
#   pre-push
#
#   Runs the full offline pytest gate before any push, so a PR can never
#   leave the machine with red offline tests. See
#   .githooks/pre_push_gate.py for the rule and its rationale.
#
#   Enable in a fresh clone with:
#       git config core.hooksPath .githooks
#

hook_dir=$(dirname "$0")
guard="$hook_dir/pre_push_gate.py"

[ -f "$guard" ] || exit 0   # never block a push because the guard is missing

if command -v python >/dev/null 2>&1; then
    python "$guard"
elif command -v py >/dev/null 2>&1; then
    py -3 "$guard"
else
    echo "[WARN] pre-push: no python found; offline gate SKIPPED" >&2
    exit 0
fi
